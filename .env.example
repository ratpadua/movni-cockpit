# Copy this file to ".env" and fill in the NON-secret database target.
# The database username & password are NOT stored here — each user types them
# on the app's login screen, and the app opens the DB connection with them.
#
# Where to find each part (Hostinger hPanel > Databases):
#   - DB_NAME / user: Management (Hostinger prefixes them, e.g. u123456789_movni).
#   - DB_HOST: shown in the database details (an IP or hostname). Do NOT use
#     "localhost" -- that only works on the server itself.
#   - Remote MySQL: allow the host(s) that will connect ("%" allows any host).

DB_HOST=193.203.xxx.xxx
DB_PORT=3306
DB_NAME=u123456789_dbname

# Optional: encrypt the connection to the database (TLS, server certificate is
# verified). Leave unset/false unless your database host supports and requires it.
# DB_SSL=true

# Port the local server listens on (the app opens here in your browser)
PORT=5178

# Where generated contract files are written (relative to project root)
CONTRACTS_DIR=./storage/contracts

# ---------------------------------------------------------------------------
# DEV ONLY: to run CLI scripts (db:migrate / db:seed / db:reset), create a
# ".env.local" (gitignored, never shipped) with the credentials:
#   DB_USER=u123456789_user
#   DB_PASS=your-password
# ---------------------------------------------------------------------------
